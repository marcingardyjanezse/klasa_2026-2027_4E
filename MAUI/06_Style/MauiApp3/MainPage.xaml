<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp3.MainPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="Gold"/>
            </Style>
            <Style TargetType="Button" x:Key="GrozneButtony">
                <Setter Property="BackgroundColor" Value="Red"/>
            </Style>

            <Style TargetType="Button" x:Key="Styl1Buttona">
                <Setter Property="BackgroundColor" Value="Green"/>
            </Style>
            <Style TargetType="Button" x:Key="Styl2Buttona" BasedOn="{StaticResource Styl1Buttona}">
                <Setter Property="TextColor" Value="Blue" />
            </Style>

            <Style TargetType="Button" Class="buttonbckg">
                <Setter Property="BackgroundColor" Value="Gold"/>
            </Style>
            <Style TargetType="Button" Class="buttontext">
                <Setter Property="TextColor" Value="Blue" />
            </Style>


        </ResourceDictionary>
    </ContentPage.Resources>
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />            
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />            
        </Grid.ColumnDefinitions>

        <Label Text="Wartość A:" Grid.Column="0" Grid.Row="1"  />
        <Entry Grid.Column="1" Grid.Row="1"/>

        <Label Text="Wartość B:" Grid.Column="0" Grid.Row="2"/>
        <Entry Grid.Column="1" Grid.Row="2"/>

        <Label Text="Wynik:" Grid.Column="0" Grid.Row="3"/>
        <Label Text="0" Grid.Column="1" Grid.Row="3"/>

        <Button Text="Suma"
                Style="{StaticResource OperacjeMatematyczne}"
                Grid.Column="0" Grid.Row="4"/>
        <Button Text="Różnica"
                Style="{StaticResource OperacjeMatematyczne}"
                Grid.Column="1" Grid.Row="4"/>
        <Button Text="Iloczyn"
                Style="{StaticResource OperacjeMatematyczne}"
                Grid.Column="0" Grid.Row="5"/>
        <Button Text="Iloraz"
                Style="{StaticResource OperacjeMatematyczne}"
                Grid.Column="1" Grid.Row="5"/>

        <Button Text="Zeruj" Grid.Column="0" Grid.Row="6"/>
        <Button Text="Resetuj" Grid.Column="1" Grid.Row="6"/>

        <Button Text="Kasuj"
                Style="{StaticResource GrozneButtony}"
                Grid.Column="0" Grid.Row="7"/>
        <Button Text="Zabij"
                Style="{StaticResource GrozneButtony}"
                Grid.Column="1" Grid.Row="7"/>

        <Button Text="Button1"
                Style="{StaticResource Styl1Buttona}"
                Grid.Column="0" Grid.Row="7"/>
        <Button Text="Button2"
                Style="{StaticResource Styl2Buttona}"
                Grid.Column="1" Grid.Row="7"/>

        <Button Text="Button3"
                StyleClass="buttonbckg, buttontext"
                Grid.Column="2" Grid.Row="7"/>

    </Grid>
    
    

</ContentPage>

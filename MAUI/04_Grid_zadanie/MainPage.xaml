<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp11.MainPage">

    <StackLayout>
        <Button Text="Button 1"/>
        <Button Text="Button 2"/>
        <Button Text="Button 3"/>
        <!--<StackPanel Orientation="Horizontal">
            <Button Content="Button 4"/>
            <Button Content="Button 5"/>
            <Button Content="Button 6"/>
        </StackPanel>-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Text="Button 4" Grid.Row="0" Grid.Column="0"/>
            <Button Text="Button 5" Grid.Row="0" Grid.Column="1"/>
            <Button Text="Button 6" Grid.Row="0" Grid.Column="2"/>
            <Button Text="Button 7" Grid.Row="1" Grid.Column="0"/>
            <Button Text="Button 8" Grid.Row="1" Grid.Column="1"/>
            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Text="Button A" Grid.Row="0" Grid.Column="0"/>
                <Button Text="Button B" Grid.Row="0" Grid.Column="1"/>
                <Button Text="Button C" Grid.Row="0" Grid.Column="2"/>
                <Button Text="Button D" Grid.Row="1" Grid.Column="0"/>
                <Button Text="Button E" Grid.Row="1" Grid.Column="1"/>
                <Button Text="Button F" Grid.Row="1" Grid.Column="2"/>
            </Grid>

        </Grid>

    </StackLayout>



</ContentPage>
